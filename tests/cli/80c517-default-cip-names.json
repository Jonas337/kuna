{
  "schema": "re-probe/1",
  "kind": "cli",
  "cmd": [
    "{{KUNA}}",
    "decompile",
    "{{BIN}}",
    "0x0",
    "--raw-image",
    "--target",
    "8051:BE:16:default",
    "--base",
    "0x0"
  ],
  "cwd": "{{WORK}}",
  "env": {
    "SLEIGHHOME": "{{SPECS}}"
  },
  "stdin": null,
  "timeout_s": 60,
  "repeat": 1,
  "target": {
    "binary_rel": "decompiler/crates/kuna-analysis/tests/fixtures/raw_8051_80c517_sfr",
    "binary_sha256": "9cd3f389cb948294129929ff9ead1cbf80782be92f388430cd13989f3bb74183",
    "binary_size": 6,
    "binary_source": "in-repo",
    "in_repo_path": "decompiler/crates/kuna-analysis/tests/fixtures/raw_8051_80c517_sfr",
    "selector": "0x0",
    "selector_kind": "addr"
  },
  "expect": {
    "exit_code": {
      "eq": 0
    },
    "stdout_matches": [
      "FIFLG1 = 0xf1;",
      "HIFLG\\.1 = 0;"
    ],
    "stdout_absent": [
      "CCEN",
      "CM1"
    ]
  },
  "notes": "Negative companion to 80c517-sfr-names: the stock 8051 target must keep the CIP-51 names for the same six bytes. This pins that adding the 80C517A variant does not change existing 8051 targets."
}
